<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync with the encrypted backend. Reminder permissions come from the notification plugin's own manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The notification plugin also declares these; Life OS schedules inexact reminders and holds no wake locks. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!--
      Backups and device-to-device transfer are off: the planner is recovered from the encrypted cloud copy with
      the passphrase, and the Keystore key that protects the local files cannot be backed up anyway.
      Cleartext HTTP is off twice over (attribute and network security config).
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The only exported component: the launcher needs to start it. No deep links, no custom URL scheme. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- No FileProvider: the app shares no files. Backups leave through the system "save as" picker. -->

        <!-- AndroidX adds this exported receiver for developer profiling tools (shell-only). Nothing here needs it. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
