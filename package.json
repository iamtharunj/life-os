{
  "name": "life-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:lan": "node server.mjs --lan",
    "dev": "node server.mjs --dev",
    "build": "tsc --noEmit && node server.mjs --build",
    "typecheck": "tsc --noEmit",
    "test": "node src/lib/selftest.ts",
    "build:mobile": "node server.mjs --mobile && cap sync android",
    "android:apk": "npm run build:mobile && node android/gradlew.mjs assembleDebug",
    "android:check": "node android/gradlew.mjs testDebugUnitTest lintDebug",
    "test:app": "node tests/app-e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
